{
  "name": "finoras-store",
  "private": true,
  "version": "1.0.0",
  "description": "Finora's Store - Cross-Platform Open Source App Store powered by GitHub Releases",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:linux": "vite build && npx electron-builder --linux deb AppImage",
    "build:win": "vite build && npx electron-builder --win nsis zip",
    "build:mac": "vite build && npx electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.finora.store",
    "productName": "Finora's Store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/logo.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
