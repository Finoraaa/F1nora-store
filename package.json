{
  "name": "finoras-store",
  "private": true,
  "version": "1.0.0",
  "description": "Finora's Store - Cross-Platform Open Source App Store powered by GitHub Releases",
  "main": "electron/main.cjs",
  "author": "Finoraaa <Finoraaa@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "cap:sync": "vite build && npx cap sync android",
    "build:android": "npm run cap:sync && cd android && ./gradlew assembleDebug && cd ..",
    "build:linux": "vite build && electron-builder --linux AppImage deb",
    "build:win": "vite build && electron-builder --win nsis zip",
    "build:mac": "vite build && electron-builder --mac -c.mac.identity=null"
  },
  "build": {
    "appId": "com.finora.store",
    "productName": "Finoras Store",
    "executableName": "finoras-store",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "linux": {
      "maintainer": "Finoraaa <Finoraaa@users.noreply.github.com>",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "public/logo.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/logo.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.2.0"
  }
}
